# Copy this file to .env.local and fill in the blank values.
# All variables below are server-only. Do not add a VITE_ prefix to secrets.

# WHOOP Developer Dashboard -> your app -> Client credentials
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Your WHOOP account email. Only this account can connect to this personal app.
WHOOP_ALLOWED_EMAIL=

# Local development will run on port 3001.
# Register WHOOP_REDIRECT_URI exactly in the WHOOP Developer Dashboard.
# If using an HTTPS tunnel or deploying, update both URLs to that origin.
APP_URL=http://localhost:3001
WHOOP_REDIRECT_URI=http://localhost:3001/api/auth/whoop/callback

# Enable the read permissions in the WHOOP Developer Dashboard.
# "offline" is requested by our OAuth code and enables refresh tokens.
WHOOP_SCOPES="read:profile read:body_measurement read:cycles read:recovery read:sleep read:workout offline"

# Generate each secret separately with: openssl rand -hex 32
# Used to protect the dashboard's session cookie.
SESSION_SECRET=

# Exactly 64 hexadecimal characters (32 bytes); encrypts stored WHOOP tokens.
# Keep this stable: changing it requires reconnecting your WHOOP account.
TOKEN_ENCRYPTION_KEY=

# PostgreSQL storage for synced stats and encrypted OAuth tokens.
# Replace with your database connection string; URL-encode special characters
# in the username/password. For hosted databases, retain the provider's TLS options.
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/whoop_dashboard"

# Optional. Enables the MCP endpoint at /api/mcp for AI agents. Generate with:
# openssl rand -hex 32. Leave empty to keep the endpoint switched off.
MCP_BEARER_TOKEN=
